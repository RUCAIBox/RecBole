#Plain concat (defaults):
python run_recbole.py --model SASRecAlign --dataset Amazon_Beauty \
  --config_files sasrec_base_plain.yaml --config_dict "seed=2020"

#With weight only
python run_recbole.py --model SASRecAlign --dataset Amazon_Beauty \
  --config_files "sasrec_base_plain.yaml overrides/sasrec_text_weight_0.2.yaml"

# long tail only
python run_recbole.py --model SASRecAlign --dataset Amazon_Beauty \
  --config_files "sasrec_base_plain.yaml overrides/sasrec_tail_threshold_5.yaml"

# both weight & long tail
python run_recbole.py --model SASRecAlign --dataset Amazon_Beauty \
  --config_files "sasrec_base_plain.yaml overrides/sasrec_text_conservative.yaml"

